#include <stdio.h>

int main() {
    int items, total = 0;

    printf("Enter items produced each hour (-1 to stop):\n");

    while(1) {
        scanf("%d", &items);

        if(items == -1) {
            break;
        }

        total += items;
    }

    printf("Total production = %d", total);

    return 0;
}
