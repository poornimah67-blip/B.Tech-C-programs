#include <stdio.h>

int main() {
    float num1, num2;
    char op;

    printf("Enter first number: ");
    scanf("%f", &num1);

    printf("Enter second number: ");
    scanf("%f", &num2);

    printf("Enter operator (+, -, *, /): ");
    scanf(" %c", &op);  // space before %c to avoid input issues

    if (op == '+') {
        printf("Result = %.2f", num1 + num2);
    }
    else if (op == '-') {
        printf("Result = %.2f", num1 - num2);
    }
    else if (op == '*') {
        printf("Result = %.2f", num1 * num2);
    }
    else if (op == '/') {
        if (num2 != 0) {
            printf("Result = %.2f", num1 / num2);
        } else {
            printf("Cannot divide by zero");
        }
    }
    else {
        printf("Invalid operator");
    }

    return 0;
}
