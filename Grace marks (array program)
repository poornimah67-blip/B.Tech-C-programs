#include <stdio.h>

int main() {
    int marks[10], i;

    printf("Enter marks of 10 students:\n");
    for(i = 0; i < 10; i++) {
        scanf("%d", &marks[i]);
    }

    // Add grace marks
    for(i = 0; i < 10; i++) {
        if(marks[i] < 40) {
            marks[i] += 5;
        }
    }

    printf("Updated marks:\n");
    for(i = 0; i < 10; i++) {
        printf("%d ", marks[i]);
    }

    return 0;
}
