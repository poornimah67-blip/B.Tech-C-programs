#include <stdio.h>

int main() {
    int ram, shyam, ajay, youngest;

    printf("Enter ages: ");
    scanf("%d %d %d", &ram, &shyam, &ajay);

    youngest = (ram < shyam) 
                ? (ram < ajay ? ram : ajay)
                : (shyam < ajay ? shyam : ajay);

    if (youngest == ram)
        printf("Ram is the youngest");
    else if (youngest == shyam)
        printf("Shyam is the youngest");
    else
        printf("Ajay is the youngest");

    return 0;
}
