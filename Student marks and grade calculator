#include <stdio.h>

int main() {
    int marks[5], i;
    float total = 0, average;
    char grade;

    printf("Enter marks for 5 subjects:\n");

    for(i = 0; i < 5; i++) {
        printf("Subject %d: ", i + 1);
        scanf("%d", &marks[i]);
        total += marks[i];
    }

    average = total / 5;

    // Grade calculation (real-life logic)
    if(average >= 90)
        grade = 'A';
    else if(average >= 75)
        grade = 'B';
    else if(average >= 60)
        grade = 'C';
    else if(average >= 40)
        grade = 'D';
    else
        grade = 'F';

    printf("\nTotal Marks = %.2f\n", total);
    printf("Average = %.2f\n", average);
    printf("Grade = %c\n", grade);

    return 0;
}
